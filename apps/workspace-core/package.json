{
  "name": "@cairn/workspace-core",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn Workspace Core service: HTTP API shell for the shared collaboration core.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "echo '@cairn/workspace-core is source-only; nothing to build'",
    "clean": "rimraf .turbo dist coverage"
  },
  "dependencies": {
    "@fastify/sensible": "catalog:",
    "fastify": "catalog:",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "rimraf": "^6.0.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
