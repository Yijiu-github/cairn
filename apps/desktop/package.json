{
  "name": "@cairn/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn Electron Desktop Shell.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --inspect 9229 --remoteDebuggingPort 9230",
    "preview": "electron-vite preview --skipBuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron.vite.config.ts",
    "test": "vitest run",
    "build": "electron-vite build",
    "package": "electron-builder --dir -c.electronVersion=$(node -p \"require('electron/package.json').version\")",
    "package:mac:dir": "electron-builder --mac --dir -c.mac.identity=- -c.electronVersion=$(node -p \"require('electron/package.json').version\")",
    "package:mac:dmg": "electron-builder --mac -c.electronVersion=$(node -p \"require('electron/package.json').version\")",
    "clean": "rimraf .turbo out dist release"
  },
  "dependencies": {
    "@cairn/ui": "workspace:*",
    "@electron-toolkit/preload": "catalog:",
    "@electron-toolkit/utils": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "rimraf": "^6.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
