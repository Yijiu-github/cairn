{
  "name": "@cairn/storage",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn storage adapters: SQLite first, PostgreSQL-ready repository foundation.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite/index.ts",
      "import": "./src/sqlite/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "echo '@cairn/storage is source-only; nothing to build'",
    "clean": "rimraf .turbo dist coverage"
  },
  "dependencies": {
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "rimraf": "^6.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
