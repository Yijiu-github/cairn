{
  "name": "@cairn/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn domain: Drizzle schema shared by SQLite / Postgres storage (SQLite-first).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    }
  },
  "files": [
    "src",
    "drizzle"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "build": "echo '@cairn/domain is schema-source; nothing to compile to dist'",
    "db:generate": "drizzle-kit generate",
    "clean": "rimraf .turbo dist coverage"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "rimraf": "^6.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
