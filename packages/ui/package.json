{
  "name": "@cairn/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn shared UI primitives, feedback components, tokens, and product components.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "import": "./src/tokens/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "import": "./src/primitives/index.ts"
    },
    "./feedback": {
      "types": "./src/feedback/index.ts",
      "import": "./src/feedback/index.ts"
    },
    "./data-display": {
      "types": "./src/data-display/index.ts",
      "import": "./src/data-display/index.ts"
    },
    "./cairn": {
      "types": "./src/cairn/index.ts",
      "import": "./src/cairn/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "echo 'ui is source-only; nothing to build'",
    "clean": "rimraf .turbo dist coverage"
  },
  "peerDependencies": {
    "react": "19",
    "react-dom": "19"
  },
  "dependencies": {
    "@radix-ui/react-slot": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "rimraf": "^6.0.1",
    "typescript": "catalog:"
  }
}
