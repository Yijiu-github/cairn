# 强制跨平台行尾一致性（与 .editorconfig 对齐）
# 文档：https://git-scm.com/docs/gitattributes

# 默认所有文本文件 LF
* text=auto eol=lf

# Windows 专属脚本保留 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Shell 脚本强制 LF（即使在 Windows 编辑）
*.sh        text eol=lf
*.bash      text eol=lf

# 二进制（不做 EOL 转换，不做 diff）
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.svg       text eol=lf
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.7z        binary
*.dmg       binary
*.exe       binary
*.msi       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.node      binary
*.sqlite    binary
*.db        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary

# 锁文件不做 diff（噪声大，且不应手动编辑）
pnpm-lock.yaml      -diff
package-lock.json   -diff
yarn.lock           -diff

# 大文件标记（用 LFS 时按需启用）
# *.psd  filter=lfs diff=lfs merge=lfs -text
# *.fig  filter=lfs diff=lfs merge=lfs -text

# linguist hints（让 GitHub 语言统计更准）
docs/**       linguist-documentation
*.md          linguist-documentation
**/__fixtures__/**  linguist-vendored
*.generated.*       linguist-generated
