# Cairn — 开发态环境变量模板
# 复制为 .env 后填值。.env / .env.local 不入库。
# 所有变量统一以 CAIRN_ 开头，避免与系统变量冲突。

# ============================================================================
# 运行模式
# ============================================================================
# development | production | test
NODE_ENV=development

# 编排底座实现：langgraph_js | naive (见 ADR-0014)
CAIRN_SCHEDULER_IMPL=langgraph_js

# 部署模式：local_desktop | remote_server
CAIRN_DEPLOYMENT_MODE=local_desktop

# ============================================================================
# Workspace Core
# ============================================================================
# 监听 host：本机模式严禁使用 0.0.0.0；远程模式由 server 自管
CAIRN_CORE_HOST=127.0.0.1

# 监听端口：0 = OS 自动分配（推荐）
CAIRN_CORE_PORT=0

# Loopback 鉴权 token：留空时由桌面端启动时随机生成并注入（推荐）
# 远程模式由 server 自行决定（OIDC / API key 等，详见 ADR-0007 后续 ADR）
# CAIRN_CORE_TOKEN=

# ============================================================================
# 数据库
# ============================================================================
# 本地模式：SQLite 文件路径
# 默认 <userData>/Cairn/workspaces/<id>/workspace.sqlite
# CAIRN_DB_PATH=

# 远程模式：PostgreSQL 连接串
# DATABASE_URL=postgres://user:password@localhost:5432/cairn

# 内网共享 MySQL（记录用，当前代码尚未支持 MySQL storage adapter）
# 不要把真实密码写入仓库；如需本机实验，复制到 .env.local 或本机 .env 后再填。
# CAIRN_DEV_SHARED_MYSQL_HOST=192.168.1.6
# CAIRN_DEV_SHARED_MYSQL_PORT=3306
# CAIRN_DEV_SHARED_MYSQL_USER=tsy
# CAIRN_DEV_SHARED_MYSQL_PASSWORD=

# ============================================================================
# 日志
# ============================================================================
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ============================================================================
# 遥测（详见 docs/legal/privacy-statement.md）
# ============================================================================
# 默认开启，可在应用 UI 关闭
CAIRN_TELEMETRY_ENABLED=true

# ============================================================================
# 第三方 Provider（仅开发态使用本机变量；生产由系统 Keychain/DPAPI 管理）
# ============================================================================
# ⚠️ 切勿把真实 key 提交到仓库；生产环境通过 UI 配置 → safeStorage 落盘
# CAIRN_DEV_OPENAI_API_KEY=
# CAIRN_DEV_ANTHROPIC_API_KEY=

# ============================================================================
# 仅用于 Spike / 测试
# ============================================================================
# 使用 mock runtime adapter 而非真实 provider
# CAIRN_USE_MOCK_ADAPTER=false
