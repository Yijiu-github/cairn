# pnpm 项目级配置
# 文档：https://pnpm.io/npmrc

# --- 安装行为 ---
auto-install-peers=true
strict-peer-dependencies=false
prefer-frozen-lockfile=true

# --- 模块解析 ---
# 首选 isolated（严格隔离、避免幽灵依赖），但在当前依赖组合下，Windows 会稳定触发
# ERR_PNPM_ENOENT（@ts-rest/core 嵌套 @types/node 被重命名为 .ignored_node 时 rename 失败）。
# ADR-0011 已说明必要时可改用 hoisted；全仓库统一为 hoisted，保证各 OS 与 CI 安装一致。
node-linker=hoisted

# --- public hoist（少数确实需要扁平化的） ---
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=eslint-*
public-hoist-pattern[]=@eslint/*
public-hoist-pattern[]=@typescript-eslint/*
public-hoist-pattern[]=prettier
public-hoist-pattern[]=tsx

# --- 性能 / 稳定性 ---
recursive-install=true
dedupe-peer-dependents=true
resolution-mode=highest

# --- 安全 ---
# pnpm 10+ 默认会拒绝未在 pnpm-workspace.yaml#onlyBuiltDependencies 中声明的包的安装脚本
# 此处仍保留 pnpm 9 的兼容
ignore-scripts=false

# --- 工程化 ---
engine-strict=true
save-exact=false
save-prefix=^

# --- registry ---
# 默认 npmjs，国内用户可在本机 ~/.npmrc 覆盖；不在仓库锁定镜像
# registry=https://registry.npmjs.org/

# --- Electron 缓存（避免每次都下载） ---
# 由 ELECTRON_MIRROR / ELECTRON_CACHE 环境变量控制；不在此硬编码
