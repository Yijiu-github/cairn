# pnpm 项目级配置
# 文档：https://pnpm.io/npmrc

# --- 安装行为 ---
auto-install-peers=true
strict-peer-dependencies=false
prefer-frozen-lockfile=true

# --- 模块解析 ---
# isolated：严格隔离，避免幽灵依赖（推荐，但部分工具/插件可能需要 hoist）
node-linker=isolated

# --- public hoist（少数确实需要扁平化的） ---
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=eslint-*
public-hoist-pattern[]=@eslint/*
public-hoist-pattern[]=@typescript-eslint/*
public-hoist-pattern[]=prettier
public-hoist-pattern[]=tsx

# --- 性能 / 稳定性 ---
recursive-install=true
dedupe-peer-dependents=true
resolution-mode=highest

# --- 安全 ---
# pnpm 10+ 默认会拒绝未在 pnpm-workspace.yaml#onlyBuiltDependencies 中声明的包的安装脚本
# 此处仍保留 pnpm 9 的兼容
ignore-scripts=false

# --- 工程化 ---
engine-strict=true
save-exact=false
save-prefix=^

# --- registry ---
# 默认 npmjs，国内用户可在本机 ~/.npmrc 覆盖；不在仓库锁定镜像
# registry=https://registry.npmjs.org/

# --- Electron 缓存（避免每次都下载） ---
# 由 ELECTRON_MIRROR / ELECTRON_CACHE 环境变量控制；不在此硬编码
